{
  "name": "go-meowbot-feature-db",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/go/meowbot/feature/db",
  "tags": ["type:library", "language:go", "scope:meowbot", "library:feature"],
  "targets": {
    "version": {
      "executor": "@jscutlery/semver:version",
      "options": {
        "trackDeps": true,
        "push": true,
        "preset": "conventionalcommits"
      }
    },
    "test": {
      "executor": "@nx-go/nx-go:test",
      "cache": true,
      "inputs": ["golang"]
    },
    "lint": {
      "executor": "@nx-go/nx-go:lint",
      "cache": true,
      "inputs": ["golang"]
    },
    "tidy": {
      "executor": "@nx-go/nx-go:tidy",
      "cache": true,
      "inputs": ["golang"],
      "outputs": ["{projectRoot}/go.mod", "{projectRoot}/go.sum"]
    }
  }
}
